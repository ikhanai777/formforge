<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SOLIDWORKS hosts add-ins in its own .NET Framework process. net48 is
         what every supported release (2018 onward) loads. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DrawingForge.AddIn</RootNamespace>
    <AssemblyName>DrawingForge.AddIn</AssemblyName>
    <!-- SOLIDWORKS is a 64-bit host, so the add-in must be 64-bit.
         AnyCPU is listed so the solution's Any CPU configuration resolves;
         PlatformTarget pins the actual output either way. -->
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- A COM add-in must expose its class and keep a stable GUID. -->
    <EnableComHosting>false</EnableComHosting>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <!-- Where the SOLIDWORKS interop assemblies live. Override on the command
       line for a non-default install:
         dotnet build /p:SolidWorksDir="D:\SW2024" -->
  <PropertyGroup>
    <SolidWorksDir Condition="'$(SolidWorksDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SolidWorksDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- EmbedInteropTypes must stay false: SOLIDWORKS passes real RCWs across
         the add-in boundary and embedded (no-PIA) types break the casts. -->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksDir)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksDir)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksDir)\api\redist\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="solidworkstools">
      <HintPath>$(SolidWorksDir)\api\redist\CLR2\solidworkstools.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrawingForge.Core\DrawingForge.Core.csproj" />
  </ItemGroup>

</Project>
