{
  "version": 1,
  "material": { "preset": "Matte PLA" },
  "environment": {
    "source": "Studio Softbox",
    "background": "radial",
    "backgroundColor": [0.96, 0.96, 0.97],
    "backgroundColor2": [0.78, 0.79, 0.82],
    "ground": "shadow_catcher",
    "shadowStrength": 0.7,
    "aoStrength": 0.8
  },
  "camera": { "focalLength": 70, "elevation": 18, "fill": 0.8 },
  "turntable": { "mode": "rotate_object", "seconds": 8, "fps": 30, "easing": "linear" },
  "output": { "format": "mp4", "width": 1920, "height": 1080, "quality": "standard" }
}
