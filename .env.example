# Copy to .env and edit. docker compose reads it automatically.
#
# Which model FormForge drives is entirely this file. The client is the same
# either way -- anything speaking OpenAI's chat-completions API works.

# --- Local, on your own hardware (the default) -------------------------------
# Nothing about a generation leaves the machine.
# FORMFORGE_LLM_BASE_URL=http://ollama:11434/v1
# FORMFORGE_LLM_MODEL=qwen2.5-coder:7b

# --- OpenRouter, including its free tier -------------------------------------
# A key is still needed for the free models; free means unpriced, not unauthed.
# Ask the endpoint what it currently offers rather than pasting an id from a
# blog post -- free line-ups change without notice:
#
#   docker compose run --rm formforge formforge models --free
#   docker compose run --rm formforge formforge models --free --vision
#
# FORMFORGE_LLM_BASE_URL=https://openrouter.ai/api/v1
# FORMFORGE_LLM_API_KEY=sk-or-v1-...
# FORMFORGE_LLM_MODEL=<pick one from `formforge models --free`>
#
# Optional, and OpenRouter-specific: attribution for its leaderboards.
# FORMFORGE_LLM_REFERER=https://your-site.example
# FORMFORGE_LLM_TITLE=FormForge

# --- Per-tier models ----------------------------------------------------------
# The orchestrator asks for a cheap model to fill a template, a stronger one to
# write build123d, and a stronger one still after three failures. On one free
# model these collapse to the same id, which is fine; split them if you have
# something better to escalate to.
# FORMFORGE_LLM_MODEL_FAST=
# FORMFORGE_LLM_MODEL_STANDARD=
# FORMFORGE_LLM_MODEL_ESCALATED=
