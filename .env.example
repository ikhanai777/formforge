# FormForge configuration — copy to .env and edit.
#
# PLACEHOLDERS ONLY. Never commit a real secret to this file or any other.
# .env is gitignored; .env.example is not, and that asymmetry is the whole
# point of the pair.
#
# A clean clone needs NONE of this. Every variable below has a local-safe
# default: SQLite, local files, offline billing, an email outbox that writes
# to disk. Set things here when you want to move away from those.
#
# docs/configuration.md says which variables are required in which mode and
# which component reads each one.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# local | staging | production
#   local       permissive, everything defaults to something that runs offline
#   staging     a real deployment; misconfiguration warns
#   production  a real deployment; misconfiguration REFUSES TO START
FORMFORGE_MODE=local

# ---------------------------------------------------------------------------
# Secrets  (required in production; generated per process in local)
# ---------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Two separate secrets on purpose: rotating the link secret must not sign every
# user out, and a leak of one must not be a leak of both.
FORMFORGE_SESSION_SECRET=replace-me-with-48-random-bytes
# Without this each worker invents its own, so a download link minted by one is
# rejected by the next. Harmless on a single-process laptop, an outage with two.
FORMFORGE_LINK_SECRET=replace-me-with-48-random-bytes

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated. Required in production.
FORMFORGE_ALLOWED_ORIGINS=http://localhost:8000
# Set to 1 ONLY on a plain-HTTP development box. Refused in production.
# FORMFORGE_COOKIE_INSECURE=1

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# A path is SQLite; a DSN is PostgreSQL. One setting picks the engine, because
# two settings can disagree about which database is live.
# FORMFORGE_ACCOUNTS_DB=postgresql://formforge:PASSWORD@localhost:5432/formforge
# FORMFORGE_DB=~/.formforge/formforge.db
# FORMFORGE_HOME=~/.formforge
# FORMFORGE_STORE=~/.formforge/models

# local | s3
FORMFORGE_STORAGE=local
# For local: a directory. For s3: s3://bucket/prefix
FORMFORGE_ARTIFACTS=~/.formforge/artifacts
# FORMFORGE_S3_ENDPOINT=https://s3.example.com
# S3 credentials come from the standard AWS chain (env, profile, instance role).
# Do not put them here.

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
# offline | stripe_sandbox | stripe_live
#
# Named, never inferred. Setting a Stripe key while this says `offline` is a
# startup error rather than a silent fallback: somebody believes they
# configured billing and they have not.
#
# LIVE BILLING NEEDS THREE INDEPENDENT THINGS and refuses without all of them:
#   1. FORMFORGE_BILLING=stripe_live
#   2. a real sk_live_ key
#   3. FORMFORGE_ALLOW_LIVE_BILLING=1
# A live key on its own can never move money.
FORMFORGE_BILLING=offline

# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_MAKER=price_replace_me
# STRIPE_PRICE_STUDIO=price_replace_me
# STRIPE_SUCCESS_URL=http://localhost:8000/account?checkout=done
# STRIPE_CANCEL_URL=http://localhost:8000/pricing
# FORMFORGE_ALLOW_LIVE_BILLING=1

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# outbox | smtp | disabled
#   outbox    writes each message to a file. The whole password-reset flow
#             runs and is testable with no provider and no credential.
#   smtp      a real server. Required in production if password reset is on.
#   disabled  nothing is sent; password reset must be off too.
FORMFORGE_EMAIL=outbox
FORMFORGE_EMAIL_OUTBOX=~/.formforge/outbox
FORMFORGE_EMAIL_FROM=formforge@localhost
FORMFORGE_PASSWORD_RESET=1

# SMTP, when FORMFORGE_EMAIL=smtp
# FORMFORGE_SMTP_HOST=smtp.example.com
# FORMFORGE_SMTP_PORT=587
# FORMFORGE_SMTP_USER=apikey
# FORMFORGE_SMTP_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Limits and lifecycle
# ---------------------------------------------------------------------------
# memory | redis
# `memory` is per-process: N workers means N budgets. Fine on a laptop, not a
# real limit in a deployment. See docs/configuration.md.
FORMFORGE_RATE_LIMIT_BACKEND=memory
# FORMFORGE_REDIS_URL=redis://localhost:6379/0

# Days after which an unpaid account's artifacts become eligible for deletion.
# 0 means retention is OFF and nothing is ever deleted on a schedule. Deletion
# is destructive, so it stays off until somebody sets this deliberately.
FORMFORGE_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Sandbox
# ---------------------------------------------------------------------------
# The geometry sandbox executes model-authored Python. Refused in production.
# FORMFORGE_ALLOW_UNSAFE_SANDBOX=1
# FORMFORGE_SANDBOX_RUNTIME=gvisor
# FORMFORGE_SANDBOX_IMAGE=formforge/geometry:sha256-...
# FORMFORGE_SECCOMP_PROFILE=/etc/formforge/seccomp.json

# ---------------------------------------------------------------------------
# Model client (unrelated to accounts; the generation path)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=replace-me
# FORMFORGE_OFFLINE=1
# FORMFORGE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Points the account suite at a scratch PostgreSQL. Each test DROPs and
# recreates the public schema, so never aim this at anything you care about.
# FORMFORGE_TEST_PG=host=127.0.0.1 port=5432 user=postgres dbname=formforge_test

# The opt-in integration tests (tests/integration) read FORMFORGE_IT_* only.
# Deliberately NOT listed here as settable lines: nothing in the application
# reads them, and this file is the application's environment. Putting them here
# would make it a list of things somebody sets expecting an effect.
#
# docs/staging-validation.md has the full table. Each needs its
# FORMFORGE_IT_<NAME>=1 flag *and* the service's credentials -- credentials
# alone are not consent. Two rules worth repeating:
#   * the Stripe fixture refuses a key that is not sk_test_, at setup;
#   * the disposable-PostgreSQL variable is not FORMFORGE_TEST_PG. The restore
#     rehearsal drops schemas, and its value must name a database with 'test'
#     or 'disposable' in it.
