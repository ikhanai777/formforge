{
  "_comment": [
    "Seccomp profile for the geometry sandbox. Default-deny with an allowlist:",
    "a syscall added to the kernel after this profile was written is blocked",
    "rather than permitted, which is the direction a security control should",
    "fail in.",
    "",
    "This is defence in depth, under gVisor rather than instead of it. The",
    "explicitly-denied group at the end is not load-bearing given the default",
    "action; it is listed so a reviewer can see the intent without having to",
    "diff the allowlist against a syscall table."
  ],
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_AARCH64"],
  "syscalls": [
    {
      "_comment": "Memory: OCCT allocates heavily and mmaps its own data.",
      "names": ["brk", "mmap", "mprotect", "munmap", "mremap", "madvise", "mlock", "munlock"],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Read-only filesystem access, plus writes into the /work tmpfs.",
      "names": [
        "read", "pread64", "readv", "preadv", "write", "pwrite64", "writev",
        "open", "openat", "close", "lseek", "stat", "fstat", "lstat", "newfstatat",
        "statx", "access", "faccessat", "faccessat2", "readlink", "readlinkat",
        "getdents", "getdents64", "getcwd", "fcntl", "ioctl", "dup", "dup2",
        "dup3", "pipe", "pipe2", "ftruncate", "unlink", "unlinkat", "mkdir",
        "mkdirat", "rename", "renameat", "renameat2", "fsync", "fdatasync",
        "umask", "chmod", "fchmod"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Process and thread lifecycle. OCCT and numpy use threads.",
      "names": [
        "clone", "clone3", "futex", "futex_waitv", "exit", "exit_group",
        "wait4", "waitid", "set_robust_list", "get_robust_list", "gettid",
        "getpid", "getppid", "sched_getaffinity", "sched_setaffinity",
        "sched_yield", "sched_getparam", "sched_getscheduler", "prctl",
        "set_tid_address", "rseq", "arch_prctl", "membarrier"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Signals, timers and resource limits, so rlimits work.",
      "names": [
        "rt_sigaction", "rt_sigprocmask", "rt_sigreturn", "rt_sigtimedwait",
        "sigaltstack", "kill", "tgkill", "getrlimit", "setrlimit", "prlimit64",
        "getrusage", "clock_gettime", "clock_getres", "clock_nanosleep",
        "nanosleep", "gettimeofday", "times", "timer_create", "timer_settime",
        "timer_delete", "restart_syscall"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Identity reads, and getrandom for Python's hash seed.",
      "names": [
        "getuid", "geteuid", "getgid", "getegid", "getgroups", "getrandom",
        "uname", "sysinfo", "epoll_create1", "epoll_ctl", "epoll_wait",
        "epoll_pwait", "poll", "ppoll", "select", "pselect6", "eventfd2"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": [
        "Denied explicitly, for the reviewer's benefit. The default action",
        "already covers these: no network of any kind, no new namespaces, no",
        "ptrace, no BPF, no mounts, no kernel module loading, no privilege",
        "changes."
      ],
      "names": [
        "socket", "socketpair", "connect", "accept", "accept4", "bind", "listen",
        "sendto", "recvfrom", "sendmsg", "recvmsg", "setsockopt", "getsockopt",
        "ptrace", "process_vm_readv", "process_vm_writev",
        "mount", "umount2", "pivot_root", "chroot", "unshare", "setns",
        "bpf", "perf_event_open", "kexec_load", "init_module", "finit_module",
        "delete_module", "reboot", "swapon", "swapoff",
        "setuid", "setgid", "setreuid", "setregid", "setresuid", "setresgid",
        "capset", "add_key", "keyctl", "request_key",
        "execve", "execveat", "fork", "vfork", "userfaultfd"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}
